{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_BASE=/tracking/ VITE_BACKEND_PREFIX=/tracking/backend npm run build -- --outDir dist",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "https://dgipr.hashcase.tech/tracking/", "permanent": false },
    { "source": "/app/:path*", "destination": "https://dgipr.hashcase.tech/tracking/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/tracking/backend/(.*)", "destination": "https://54-169-233-35.sslip.io/$1" },
    { "source": "/tracking/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/tracking(/.*)?", "destination": "/index.html" }
  ]
}
