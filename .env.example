# Copy to .env (never commit .env). All values are read server-side only.

# ---- Storage
# DATA_DIR=./data                       # SQLite database, generated PDFs
# DATABASE_URL=sqlite:///./data/dgipr.sqlite3

# ---- Provider per platform (see README "Replacing or adding a provider")
#   facebook / instagram: apify | brightdata | fixture | fixture:brightdata
#   x: twitterapi_io | apify | fixture        youtube: youtube_data_api | fixture
# "fixture" = SYNTHETIC sample responses, for demos/tests only.
PROVIDER_FACEBOOK=apify
PROVIDER_INSTAGRAM=apify
PROVIDER_X=twitterapi_io
PROVIDER_YOUTUBE=youtube_data_api

# ---- Credentials (our own accounts; account owners provide nothing)
# APIFY_API_KEY is accepted as an alias for APIFY_TOKEN
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITTERAPI_IO_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed if PROVIDER_FACEBOOK/INSTAGRAM=brightdata
BRIGHTDATA_API_KEY=

# ---- Provider tuning (defaults shown)
# APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
# APIFY_FACEBOOK_ACTOR=apify~facebook-posts-scraper
# APIFY_X_ACTOR=kaitoeasyapi~twitter-x-data-tweet-scraper-pay-per-result-cheapest   # used when PROVIDER_X=apify
# APIFY_X_RESULTS_LIMIT=500
# APIFY_RESULTS_LIMIT=200               # per account per run; a run that hits it is marked "window may be truncated"
# APIFY_FACEBOOK_RESULTS_LIMIT=200      # Facebook only; overrides APIFY_RESULTS_LIMIT (busy Pages post ~40/day)
# APIFY_MAX_WAIT_SECONDS=900
# INSTAGRAM_COLLECT_REELS_TAB=true      # second Apify pass over the reels tab (deduplicated by shortcode)
# BRIGHTDATA_FACEBOOK_DATASET=gd_lkaxegm826bjpoo9m5
# BRIGHTDATA_INSTAGRAM_DATASET=gd_lk5ns7kz21pck8jpis
# BRIGHTDATA_DATE_FORMAT=%m-%d-%Y       # verify on first live run (not specified in public docs)
# BRIGHTDATA_NUM_OF_POSTS=200
# BRIGHTDATA_MAX_WAIT_SECONDS=1200
# TWITTERAPI_IO_MODE=timeline           # timeline (user timeline) | search (advanced_search with since/until)
# MAX_PAGES_PER_ACCOUNT=50
# HTTP_TIMEOUT_SECONDS=60
# HTTP_MAX_RETRIES=4
# OVERLAP_HOURS=6
# COLLECTION_PARALLELISM=4
# REPLAY_STEP_SECONDS=1.2            # pace of the step-by-step replay when a window is already collected; 0 = instant

# ---- PDF rendering: "" uses Playwright's Chromium (run `playwright install chromium`);
# "msedge" or "chrome" use an installed browser instead.
# PDF_BROWSER_CHANNEL=msedge


# Login: the first state admin is created from these when no state user exists yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Analytics AI: the Marathi daily brief and the ask box (OpenAI Responses API).
# Without a key or model the page shows the template brief and the fixed question list instead.
# The model never produces numbers: it words text around fact placeholders and maps questions to fixed queries.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=                        # exact model id
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_DAILY_CALL_LIMIT=200              # calls per day across all users; over it, the fallbacks are used
